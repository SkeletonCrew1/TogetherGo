# web/.env is optional. Every value here has a working default, so a fresh
# clone needs nothing but `make up` from the repository root.
#
# These are Vite variables, which means they are inlined into the bundle at
# build time — `import.meta.env.VITE_API_BASE_URL` becomes a string literal in
# the emitted JavaScript. Changing one requires a rebuild; setting it on a
# running container does nothing. In development the Vite dev server reads this
# file through the bind mount, so an edit needs the `web` container restarted.

# The API origin. Left empty on purpose, and this is the normal case: the SPA
# is served by Traefik on http://localhost:8080, the same origin as /api, so
# requests go to relative paths and there is no cross-origin call to grant.
# Same-origin is also what an httpOnly refresh cookie needs.
#
# Set it only for a bundle served from somewhere the API is not.
VITE_API_BASE_URL=

# The websocket origin for /ws/chat. Also empty on purpose: the chat socket
# derives its host from window.location and its scheme from location.protocol,
# so it follows the page wherever the page is served from. Set it only when the
# socket lives somewhere the page does not — e.g. wss://chat.example.com.
VITE_WS_BASE_URL=

# How the refresh token travels.
#
#   body   — the token is in the JSON of /api/auth/refresh. What the identity
#            service does today (app/schemas/auth.py: RefreshRequest requires
#            refresh_token, and nothing in identity sets a cookie).
#   cookie — identity sets an httpOnly cookie and /api/auth/refresh is called
#            with an empty body and credentials: 'include'. The target design;
#            flip this the day identity ships it, no other change needed.
VITE_REFRESH_TRANSPORT=body

# Nominatim reverse geocoding for the map picker. The public instance rate-limits
# hard; the picker degrades to "no name found" and the field stays editable.
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org
