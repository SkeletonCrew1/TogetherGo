# The gateway. Left empty in dev so requests go through the Vite proxy and stay
# same-origin, which is what an httpOnly refresh cookie needs.
VITE_API_BASE_URL=

# How the refresh token travels.
#
#   body   — the token is in the JSON of /api/auth/refresh. What the identity
#            service does today (app/schemas/auth.py: RefreshRequest requires
#            refresh_token, and nothing in identity sets a cookie).
#   cookie — identity sets an httpOnly cookie and /api/auth/refresh is called
#            with an empty body and credentials: 'include'. The target design;
#            flip this the day identity ships it, no other change needed.
VITE_REFRESH_TRANSPORT=body

# Nominatim reverse geocoding for the map picker. The public instance rate-limits
# hard; the picker degrades to "no name found" and the field stays editable.
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org
